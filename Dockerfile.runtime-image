# A minimal sandbox image for frontend build/test/preview workloads. This
# is the image the worker creates *sandbox* containers from (never the
# worker's own image). It never runs as root and carries no docker CLI,
# no ssh, and no outbound-network tooling of its own; the worker's
# `--network none` and capability drops are the actual enforcement, this
# is defense in depth for the tools this image happens to ship.
FROM node:22-bookworm-slim
RUN corepack enable \
  && groupadd --gid 1000 sandbox \
  && useradd --uid 1000 --gid 1000 --create-home sandbox \
  && rm -rf /var/lib/apt/lists/*
USER sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]
